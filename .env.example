# =============================================================================
# tfvn-tarot — environment template (Wave 2, task W2.2)
# -----------------------------------------------------------------------------
# Usage:
#   cp .env.example .env        # fill in real values, NEVER commit .env
#
# The generation client resolves endpoints as OpenAI protocol:
#   {LLM_BASE_URL}/chat/completions   (POST, Bearer auth, {"model", "messages", ...})
# Compatible with any OpenAI-protocol gateway/proxy (OpenRouter, LM Studio,
# vLLM, llama.cpp server, self-hosted relay, etc.).
#
# All keys are optional in code paths that don't need them; unset values
# trigger the documented fallback (e.g. keyword-overlap for embeddings).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Generation LLM — custom OpenAI-protocol endpoint (W2.2 core)
#    Used for: Vietnamese reversed-meaning synthesis, W3 reading generation.
#    MUST end in /v1 if the provider uses the OpenAI versioned path.
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://your-gateway.example.com/v1
# OpenAI-compatible Bearer token for the endpoint above.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model id as exposed by the endpoint (frontier model; must be a different
# architecture/family from nothing — any capable model for SYNTHESIS).
LLM_MODEL=deepseek-chat
# Second-tier model for the Wave 3 mix: Judge (W3.4 L4) + Critique (W3.2) on
# Sonnet, bulk generation on Haiku. Optional — unset = single-tier operation.
LLM_MODEL_SONNET=claude-sonnet-4-5-20250929

# Output cap for a single completion (reversed prose ~200 tokens, readings up
# to 700 tokens; 2048 is a safe ceiling).
LLM_MAX_TOKENS=2048

# Two-stage temperature split (W3.2: prompts at higher temp, readings lower).
# W2.2 generates TWO variants per card — variant diversity comes from sampling,
# so leave the two values distinct.
LLM_TEMPERATURE_PROMPT=1.0
LLM_TEMPERATURE_READING=0.7

# Per-request timeout in seconds (generation is synchronous).
LLM_TIMEOUT=120

# Reasoning models: this gateway supports {"type":"disabled"} to skip the
# chain-of-thought (fast, cheap, no empty-content budget blowouts). Set
# "enabled" only if your endpoint rejects the thinking field (the client then
# retries without it automatically on HTTP 400).
LLM_THINKING=disabled

# -----------------------------------------------------------------------------
# 2. Judges (existing convention — judge/taxonomy.json)
#    Primary: deepseek-chat (calibrated: tone/translationese/faithfulness gate
#    C3 layer 4). Secondary: claude-sonnet-4 (architecturally unrelated, Metis
#    B4). Until SECONDARY_JUDGE_API_KEY is set, layer 4 stays a
#    self-consistency filter (W0.6 caveat) — set it to lift the caveat.
#    Also used by W2.2's forbidden-claims gate.
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SECONDARY_JUDGE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 3. Embeddings — OPTIONAL (W2.1 orientation attribution)
#    If the endpoint exposes POST /embeddings, set EMBEDDING_MODEL to use
#    real similarity; unset -> W2.1 falls back to keyword-overlap attribution
#    (documented fallback in the plan, no failure).
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# 4. Generation cache & reproducibility
#    Every generation is cached by prompt-hash (plan: "ALL generations cached
#    by prompt hash"); a cache hit never re-bills the endpoint.
# -----------------------------------------------------------------------------
GEN_CACHE_DIR=.cache/gen
# Fixed seed matches the taxonomy/calibration seed convention (42).
GEN_SEED=42
